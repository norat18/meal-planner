rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's recipes, settings and plan live under users/{their uid}. Only they can read or write them.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else (including the import function's usage counters in /usage) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
